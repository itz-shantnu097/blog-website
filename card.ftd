-- import: sarvom.github.io/poppins/assets as poppins-assets

-- component feature-card:
caption heading:
body content:
string author:
string date:
ftd.image-src cover:
string comments:
boolean $click-heart: false
boolean $hover-heading: false
boolean $hover-content: false
string blog-link:

-- ftd.column:
background.solid: #fff
link: $feature-card.blog-link

	-- ftd.row:
	if: { ftd.device == "desktop" }
	width: fill-container
	height.fixed.px: 400
	
		-- ftd.image:
		src: $feature-card.cover
		width.fixed.percent: 50
		height.fixed.px: 400
		
		-- ftd.column:
		width.fixed.percent: 50
		height: hug-content
		padding-horizontal.px: 50
		padding-top.px: 41
		border-top-width.px: 1
		border-right-width.px: 1
		border-bottom-width.px: 1
		border-color: #bfbfbf
		
		
			-- ftd.text: $feature-card.author
			role: $poppins-size-12-400
			
			-- ftd.text: $feature-card.date
			role: $poppins-size-12-400
			margin-bottom.px: 5
			
			-- ftd.text: $feature-card.heading
			role: $poppins-size-28-700
			margin-bottom.px: 10
			color: #000
			color if { feature-card.hover-heading }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $feature-card.hover-heading, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $feature-card.hover-heading, v = false)
			
			-- ftd.text: $feature-card.content
			role: $poppins-size-16-400
			color: #000
			color if { feature-card.hover-content }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $feature-card.hover-content, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $feature-card.hover-content, v = false)
			
			
			-- ftd.row:
			width.fixed.percent: 100
			margin-top.percent: 20
			padding-vertical.px: 15
			border-top-width.px: 1
			border-color: #bfbfbf
			spacing: space-between
			
				-- ftd.row:
				spacing.fixed.px: 10
				
					-- ftd.text: $feature-card.comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
					-- ftd.text: comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
				-- end: ftd.row

				-- ftd.image:
				src: $assets.files.assets.heart-empty.svg
				if: { !feature-card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $feature-card.click-heart, v = true)
				
				-- ftd.image:
				src: $assets.files.assets.heart-full.svg
				if: { feature-card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $feature-card.click-heart, v = false)
				
			-- end: ftd.row



		-- end: ftd.column


	-- end: ftd.row



	-- ftd.column:
	if: { ftd.device == "mobile" }
	width: fill-container
	
		-- ftd.image:
		src: $feature-card.cover
		width: fill-container
		height.fixed.percent: 50
		
		-- ftd.column:
		width: fill-container
		height: hug-content
		padding-horizontal.px: 15
		padding-top.px: 30
		border-left-width.px: 1
		border-right-width.px: 1
		border-bottom-width.px: 1
		border-color: #bfbfbf
		
		
			-- ftd.text: $feature-card.author
			role: $poppins-size-12-400
			
			-- ftd.text: $feature-card.date
			role: $poppins-size-12-400
			margin-bottom.px: 5
			
			-- ftd.text: $feature-card.heading
			role: $poppins-size-28-700
			margin-bottom.px: 10
			color: #000
			color if { feature-card.hover-heading }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $feature-card.hover-heading, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $feature-card.hover-heading, v = false)
			
			-- ftd.text: $feature-card.content
			role: $poppins-size-16-400
			color: #000
			color if { feature-card.hover-content }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $feature-card.hover-content, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $feature-card.hover-content, v = false)
			margin-bottom.percent: 20
			
			
			-- ftd.row:
			width.fixed.percent: 100
			padding-vertical.px: 15
			border-top-width.px: 1
			border-color: #bfbfbf
			spacing: space-between
			
				-- ftd.row:
				spacing.fixed.px: 10
				
					-- ftd.text: $feature-card.comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
					-- ftd.text: comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
				-- end: ftd.row

				-- ftd.image:
				src: $assets.files.assets.heart-empty.svg
				if: { !feature-card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $feature-card.click-heart, v = true)
				
				-- ftd.image:
				src: $assets.files.assets.heart-full.svg
				if: { feature-card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $feature-card.click-heart, v = false)
				
			-- end: ftd.row


		-- end: ftd.column


	-- end: ftd.column


-- end: ftd.column

-- end: feature-card



-- component card:
caption heading:
body content:
string author:
string date:
ftd.image-src cover:
string comments:
boolean $click-heart: false
boolean $hover-heading: false
boolean $hover-content: false
string blog-link:

-- ftd.column:
background.solid: #fff
link: $card.blog-link

	-- ftd.column:
	if: { ftd.device == "desktop" }
	width: fill-container
	height: hug-content
	
		-- ftd.image:
		src: $card.cover
		width.fixed.percent: 100
		height.fixed.px: 400
		
		-- ftd.column:
		width.fixed.percent:
		height: hug-content
		padding-horizontal.px: 25
		padding-top.px: 30
		border-top-width.px: 1
		border-left-width.px: 1
		border-right-width.px: 1
		border-bottom-width.px: 1
		border-color: #bfbfbf
		
			-- ftd.text: $card.author
			role: $poppins-size-12-400
			
			-- ftd.text: $card.date
			role: $poppins-size-12-400
			margin-bottom.px: 5
			
			-- ftd.text: $card.heading
			role: $poppins-size-16-400
			margin-bottom.px: 10
			color: #000
			color if { card.hover-heading }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $card.hover-heading, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $card.hover-heading, v = false)
			
			-- ftd.text: $card.content
			role: $poppins-size-14-400
			color: #000
			color if { card.hover-content }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $card.hover-content, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $card.hover-content, v = false)
			
			-- ftd.row:
			width.fixed.percent: 100
			margin-top.percent: 10
			padding-vertical.px: 15
			border-top-width.px: 1
			border-color: #bfbfbf
			spacing: space-between
			
				-- ftd.row:
				spacing.fixed.px: 10
				
					-- ftd.text: $card.comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
					-- ftd.text: comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
				-- end: ftd.row

				-- ftd.image:
				src: $assets.files.assets.heart-empty.svg
				if: { !card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $card.click-heart, v = true)
				
				-- ftd.image:
				src: $assets.files.assets.heart-full.svg
				if: { card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $card.click-heart, v = false)
				
			-- end: ftd.row


		-- end: ftd.column








	-- end: ftd.column



	-- ftd.column:
	if: { ftd.device == "mobile" }
	width: fill-container
	height: hug-content
	
		-- ftd.image:
		src: $card.cover
		width: fill-container
		height.fixed.percent: 50
		
		-- ftd.column:
		width: fill-container
		height: hug-content
		padding-horizontal.px: 15
		padding-top.px: 30
		border-left-width.px: 1
		border-right-width.px: 1
		border-bottom-width.px: 1
		border-color: #bfbfbf
		
		
			-- ftd.text: $card.author
			role: $poppins-size-12-400
			
			-- ftd.text: $card.date
			role: $poppins-size-12-400
			margin-bottom.px: 5
			
			-- ftd.text: $card.heading
			role: $poppins-size-28-700
			margin-bottom.px: 10
			color: #000
			color if { card.hover-heading }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $card.hover-heading, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $card.hover-heading, v = false)
			
			-- ftd.text: $card.content
			role: $poppins-size-16-400
			color: #000
			color if { card.hover-content }: #f1562a
			$on-mouse-enter$: $ftd.set-bool($a = $card.hover-content, v = true)
			$on-mouse-leave$: $ftd.set-bool($a = $card.hover-content, v = false)
			margin-bottom.percent: 20
			
			
			-- ftd.row:
			width.fixed.percent: 100
			padding-vertical.px: 15
			border-top-width.px: 1
			border-color: #bfbfbf
			spacing: space-between
			
				-- ftd.row:
				spacing.fixed.px: 10
				
					-- ftd.text: $card.comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
					-- ftd.text: comments
					role: $poppins-size-14-400
					color: #000
					align-self: center
					
				-- end: ftd.row

				-- ftd.image:
				src: $assets.files.assets.heart-empty.svg
				if: { !card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $card.click-heart, v = true)
				
				-- ftd.image:
				src: $assets.files.assets.heart-full.svg
				if: { card.click-heart }
				height.fixed.px: 20
				align-self: center
				$on-click$: $ftd.set-bool($a = $card.click-heart, v = false)
				
			-- end: ftd.row


		-- end: ftd.column


	-- end: ftd.column


-- end: ftd.column

-- end: card


-- ftd.type poppins-size-14-400-desktop:
size.px: 14
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.type poppins-size-14-400-mobile:
size.px: 14
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.responsive-type poppins-size-14-400:
desktop: $poppins-size-14-400-desktop
mobile: $poppins-size-14-400-mobile





-- ftd.type poppins-size-16-400-desktop:
size.px: 16
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.type poppins-size-16-400-mobile:
size.px: 16
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.responsive-type poppins-size-16-400:
desktop: $poppins-size-16-400-desktop
mobile: $poppins-size-16-400-mobile




-- ftd.type poppins-size-28-700-desktop:
size.px: 28
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.type poppins-size-28-700-mobile:
size.px: 20
weight: 500
font-family: $poppins-assets.fonts.Poppins

-- ftd.responsive-type poppins-size-28-700:
desktop: $poppins-size-28-700-desktop
mobile: $poppins-size-28-700-mobile





-- ftd.type poppins-size-12-400-desktop:
size.px: 12
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.type poppins-size-12-400-mobile:
size.px: 12
weight: 400
font-family: $poppins-assets.fonts.Poppins

-- ftd.responsive-type poppins-size-12-400:
desktop: $poppins-size-12-400-desktop
mobile: $poppins-size-12-400-mobile
